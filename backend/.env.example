# Environment
ENVIRONMENT=development
PROJECT_NAME="Custody Watch Platform"
API_V1_STR=/api/v1

# FastAPI HTTP Server
API_HOST=0.0.0.0
API_PORT=8000

# Watch TCP & UDP Receiver
TCP_HOST=0.0.0.0
TCP_PORT=9001
PUBLIC_SERVER_IP=103.44.0.5

# Security & JWT
SECRET_KEY=change_this_to_a_secure_random_secret_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Firebase Firestore (Place JSON file at backend/secrets/)
FIREBASE_CREDENTIALS_PATH=secrets/firebase_service_account.json

# Watch Settings
DEFAULT_MANUFACTURER=MNYD
DEFAULT_WATCH_IMEI=863758061830955
AUTO_POLL_GPS_ON_PING=true

